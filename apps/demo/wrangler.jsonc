{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ambientcss-demo",
  "compatibility_date": "2026-09-13",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // canonical is the bare apex; add a www -> apex redirect rule in the
  // Cloudflare dashboard rather than serving the same content on both hosts
  "routes": [
    { "pattern": "ambientcss.com", "custom_domain": true }
  ]
}
